{
  "expo": {
    "name": "PartnR",
    "slug": "partnr",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "partnr",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#f4f7fb"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.partnr.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f4f7fb"
      },
      "package": "com.partnr.app"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PartnR utilise votre position pour trouver des événements près de vous."
        }
      ]
    ]
  }
}
